{
  "name": "momentum-lab",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "author": "Roko Grga",
  "repository": "https://github.com/WebGrga/momentum-lab",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.rokogrga.momentumlab",
    "productName": "Momentum Lab",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
